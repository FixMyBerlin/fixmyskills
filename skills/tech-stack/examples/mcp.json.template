// Claude Code, user scope: add each server block with
//   claude mcp add-json --scope user <name> '<block>'
// (stored in ~/.claude.json — never in a project .mcp.json).
// Replace DATABASE_URL placeholders from local .env — never commit real credentials here.
{
  "mcpServers": {
    "postgres-tilda-dev": {
      "command": "bunx",
      "args": ["-y", "@yawlabs/postgres-mcp@latest"],
      "env": {
        "DATABASE_URL": "postgresql://USER:PASSWORD@localhost:5432/postgres"
      }
    }
  }
}
